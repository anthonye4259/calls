# Dashboard → voice server
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
DASHBOARD_ORIGIN=http://localhost:3000

# Voice server
PORT=3001
PUBLIC_BASE_URL=https://your-public-tunnel.example
CALL_STORE_PATH=data/calls.json

# Primary call-card workflow (Grok Bot)
GROK_BOT_WEBHOOK_URL=
GROK_BOT_AUTHORIZATION_HEADER=
GROK_BOT_DAILY_CALL_LIMIT=10
GROK_BOT_PER_NUMBER_LIMIT=4

# xAI Grok Voice 3.0 — native SIP is the default
XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai
XAI_REALTIME_URL=wss://api.x.ai/v1/realtime?model=grok-voice-latest
XAI_VOICE=eve
XAI_IDLE_TIMEOUT_MS=12000
XAI_TELEPHONY_MODE=xai_sip

# Returned once by POST /v2/phone-numbers when the Direct SIP number is registered.
XAI_SIP_WEBHOOK_SECRET=
# Defaults to TWILIO_PHONE_NUMBER when omitted.
XAI_SIP_NUMBER=
# Optional: only set these when the xAI SIP registration uses digest auth.
XAI_SIP_USERNAME=
XAI_SIP_PASSWORD=

# Twilio Programmable Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
VALIDATE_TWILIO_SIGNATURES=true

# Safety gates — E.164 numbers, comma separated
TEST_NUMBER_ALLOWLIST=
ALLOW_UNRESTRICTED_DIALING=false

# Set true only after a Haladir representative approves the facts and claims
# in server/src/prompt.ts.
COMPANY_PROFILE_APPROVED=false
